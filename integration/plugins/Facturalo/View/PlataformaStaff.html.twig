{% extends "Master/MenuTemplate.html.twig" %}

{% block body %}
    <div class="container py-4" style="max-width:40rem">
        <h1 class="h4">Personal de plataforma</h1>
        <p class="text-muted">Usuarios que pueden ver y usar lo técnico (plugins, actualizador, correo SMTP, claves API, registros). Separa los nicks con comas.</p>
        <form method="post" action="{{ asset('PlataformaStaff') }}">
            {{ formToken() }}
            <input type="hidden" name="action" value="save">
            <div class="mb-3">
                <label for="nicks" class="form-label">Nicks</label>
                <input type="text" id="nicks" name="nicks" class="form-control" value="{{ fsc.staffNicks() }}">
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
    </div>
{% endblock %}
