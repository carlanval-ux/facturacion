<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <group name="data" numcolumns="12">
            <column name="id" display="none" order="90"><widget type="text" fieldname="idlinea" readonly="true"/></column>
            <column name="template" display="none" order="95"><widget type="text" fieldname="idrecurrente" readonly="true"/></column>
            <column name="reference" numcolumns="2" order="100">
                <widget type="autocomplete" fieldname="referencia">
                    <values source="variantes" fieldcode="referencia" fieldtitle="referencia"/>
                </widget>
            </column>
            <column name="description" numcolumns="4" order="110"><widget type="text" fieldname="descripcion" maxlength="200"/></column>
            <column name="quantity" numcolumns="1" order="120"><widget type="number" fieldname="cantidad" min="0"/></column>
            <column name="price" numcolumns="2" order="130"><widget type="money" fieldname="pvpunitario"/></column>
            <column name="discount" numcolumns="1" order="140"><widget type="percentage" fieldname="dtopor"/></column>
            <column name="tax" numcolumns="2" order="150">
                <widget type="select" fieldname="codimpuesto">
                    <values source="impuestos" fieldcode="codimpuesto" fieldtitle="descripcion"/>
                </widget>
            </column>
        </group>
    </columns>
</view>
