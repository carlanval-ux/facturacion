<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="id" display="none" order="90">
            <widget type="text" fieldname="id" readonly="true"/>
        </column>
        <column name="sepa-receipt" order="100">
            <widget type="text" fieldname="idrecibo" readonly="true"/>
        </column>
        <column name="customer" order="110">
            <widget type="text" fieldname="codcliente" readonly="true"/>
        </column>
        <column name="amount" display="right" order="120">
            <widget type="money" fieldname="importe" readonly="true"/>
        </column>
        <column name="sepa-collection-date" order="130">
            <widget type="date" fieldname="fechacobro" readonly="true"/>
        </column>
        <column name="sepa-sequence" order="140">
            <widget type="text" fieldname="secuencia" readonly="true"/>
        </column>
        <column name="status" order="150">
            <widget type="select" fieldname="estado" translate="true" required="true">
                <values title="sepa-status-remesado">remesado</values>
                <values title="sepa-status-cobrado">cobrado</values>
                <values title="sepa-status-devuelto">devuelto</values>
            </widget>
        </column>
        <column name="sepa-return-reason" order="160">
            <widget type="select" fieldname="motivo">
                <values title="-"></values>
                <values title="AC01 - IBAN incorrecto">AC01</values>
                <values title="AC04 - Cuenta cerrada">AC04</values>
                <values title="AC06 - Cuenta bloqueada">AC06</values>
                <values title="AM04 - Fondos insuficientes">AM04</values>
                <values title="MD01 - Sin mandato valido">MD01</values>
                <values title="MD07 - Deudor fallecido">MD07</values>
                <values title="MS02 - Rechazado por el deudor">MS02</values>
                <values title="MS03 - Otro motivo">MS03</values>
                <values title="SL01 - Servicio no permitido">SL01</values>
            </widget>
        </column>
        <column name="sepa-resolution-date" order="170">
            <widget type="date" fieldname="fecharesolucion"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="success" fieldname="estado">cobrado</option>
            <option color="danger" fieldname="estado">devuelto</option>
            <option color="warning" fieldname="estado">remesado</option>
        </row>
    </rows>
</view>
