{% extends "Master/MicroTemplate.html.twig" %}

{% block fullBody %}
    <body class="fl-login">
    {% include 'Macro/Toasts.html.twig' %}
    {% from 'Macro/Utils.html.twig' import message as showMessage %}
    <main>
        <div class="w-100" style="max-width:26rem">
            <div role="status">
                {{ showMessage(log, ['error', 'critical'], 'danger') }}
                {{ showMessage(log, ['warning'], 'warning') }}
                {{ showMessage(log, ['notice'], 'success') }}
                {{ showMessage(log, ['info'], 'info') }}
            </div>
            <div class="fl-card">
                <a href="{{ asset('login') }}"><img class="fl-logo" src="{{ asset('Dinamic/Assets/Images/horizontal-logo.png') }}" alt="Facturalo"/></a>
                {% if fsc.step == 'request' %}
                    <form action="{{ asset('RecuperarClave') }}" method="post">
                        {{ formToken() }}
                        <input type="hidden" name="action" value="request">
                        <h1>Recupera tu acceso</h1>
                        <p class="fl-sub">Escribe tu usuario o tu correo y te enviaremos un enlace para elegir una contraseña nueva.</p>
                        <div class="mb-4">
                            <label for="usuario" class="form-label">Usuario o correo</label>
                            <input type="text" id="usuario" name="usuario" class="form-control form-control-lg" maxlength="100"
                                   required autocomplete="username" autofocus/>
                        </div>
                        <button type="submit" class="btn btn-lg btn-primary w-100">Enviar enlace</button>
                    </form>
                {% elseif fsc.step == 'sent' %}
                    <h1>Revisa tu correo</h1>
                    <p class="fl-sub">Si la cuenta existe, te hemos enviado un enlace para elegir una contraseña nueva. Caduca en 1 hora.</p>
                {% elseif fsc.step == 'reset' %}
                    <form action="{{ asset('RecuperarClave') }}" method="post">
                        {{ formToken() }}
                        <input type="hidden" name="action" value="reset">
                        <input type="hidden" name="t" value="{{ fsc.token }}">
                        <h1>Elige tu contraseña nueva</h1>
                        <p class="fl-sub">Mínimo 8 caracteres, con letras y números.</p>
                        <div class="mb-3">
                            <label for="fsNewPasswd" class="form-label">Contraseña nueva</label>
                            <input type="password" id="fsNewPasswd" name="fsNewPasswd" class="form-control form-control-lg" maxlength="50"
                                   required autocomplete="new-password" autofocus/>
                        </div>
                        <div class="mb-4">
                            <label for="fsNewPasswd2" class="form-label">Repite la contraseña</label>
                            <input type="password" id="fsNewPasswd2" name="fsNewPasswd2" class="form-control form-control-lg" maxlength="50"
                                   required autocomplete="new-password"/>
                        </div>
                        <button type="submit" class="btn btn-lg btn-primary w-100">Guardar contraseña</button>
                    </form>
                {% elseif fsc.step == 'done' %}
                    <h1>Contraseña cambiada</h1>
                    <p class="fl-sub">Ya puedes entrar con tu contraseña nueva.</p>
                {% else %}
                    <h1>Enlace no válido</h1>
                    <p class="fl-sub">Este enlace ha caducado o ya se ha usado. Pide uno nuevo.</p>
                {% endif %}
                <p class="mt-3 mb-0 text-center">
                    {% if fsc.step == 'invalid' %}
                        <a href="{{ asset('RecuperarClave') }}">Pedir otro enlace</a> ·
                    {% endif %}
                    <a href="{{ asset('login') }}">Volver a entrar</a>
                </p>
            </div>
        </div>
    </main>
    <footer>Facturalo · RED TELECOM CONECTA, S.L.</footer>
    </body>
{% endblock %}
