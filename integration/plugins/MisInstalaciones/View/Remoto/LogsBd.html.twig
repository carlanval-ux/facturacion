{% if logs is null %}
    <div class="alert alert-warning mb-0">{{ trans('instalacion-visor-sin-datos') }}</div>
{% elseif logs is empty %}
    <div class="alert alert-success mb-0">{{ trans('instalacion-logs-bd-ninguno') }}</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th style="width: 15%;">{{ trans('time') }}</th>
                <th>{{ trans('message') }}</th>
                <th style="width: 20%;">{{ trans('instalacion-logs-uri') }}</th>
                <th style="width: 10%;">{{ trans('user') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for log in logs %}
                <tr>
                    <td class="small text-nowrap">{{ log.time }}</td>
                    <td class="small text-break">{{ log.message }}</td>
                    <td class="small text-break">{{ log.uri }}</td>
                    <td class="small">{{ log.nick }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
