<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="sepa-mandate-reference" order="100">
            <widget type="text" fieldname="referencia"/>
        </column>
        <column name="customer" order="110">
            <widget type="autocomplete" fieldname="codcliente">
                <values source="clientes" fieldcode="codcliente" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="sepa-iban-masked" order="120">
            <widget type="text" fieldname="ibanmask"/>
        </column>
        <column name="sepa-signature-date" order="130">
            <widget type="date" fieldname="fechafirma"/>
        </column>
        <column name="sepa-scheme" order="140">
            <widget type="text" fieldname="tipo"/>
        </column>
        <column name="sepa-sequence" order="150">
            <widget type="text" fieldname="secuencia"/>
        </column>
        <column name="status" order="160">
            <widget type="text" fieldname="estado"/>
        </column>
    </columns>
    <rows>
        <row type="status">
            <option color="success" fieldname="estado">activo</option>
            <option color="secondary" fieldname="estado">revocado</option>
        </row>
    </rows>
</view>
