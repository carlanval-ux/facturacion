{% if acerca %}
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <tbody>
            <tr>
                <th class="ps-3" style="width: 30%;">{{ trans('instalacion-version-core') }}</th>
                <td>{{ acerca.version ?: '---' }}</td>
            </tr>
            <tr>
                <th class="ps-3">{{ trans('installed-plugins') }}</th>
                <td>{{ acerca.plugins }}</td>
            </tr>
            <tr>
                <th class="ps-3">{{ trans('users') }}</th>
                <td>{{ acerca.usuarios ?? '---' }}</td>
            </tr>
            </tbody>
        </table>
    </div>
{% else %}
    <p class="p-3 mb-0"><b>{{ trans('no-data') }}</b></p>
{% endif %}
