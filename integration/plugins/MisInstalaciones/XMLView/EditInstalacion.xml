<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <group name="data" numcolumns="12">
            <column name="id" display="none" order="100">
                <widget type="text" fieldname="id" readonly="true"/>
            </column>
            <column name="name" title="name" numcolumns="6" order="110">
                <widget type="text" fieldname="nombre" maxlength="100" required="true"/>
            </column>
            <column name="url" title="url" numcolumns="6" order="130">
                <widget type="text" fieldname="url" maxlength="255" required="true"/>
            </column>
            <column name="api-key" title="api-key" numcolumns="6" order="140">
                <widget type="password" fieldname="apikey" required="true"/>
            </column>
            <column name="observations" title="observations" numcolumns="12" order="150">
                <widget type="textarea" fieldname="observaciones" rows="4"/>
            </column>
        </group>
    </columns>
</view>
