<view>
    <columns>
        <group name="autoenviofacturas" numcolumns="12">
            <column name="enabled" display="left" numcolumns="2" order="100">
                <widget type="checkbox" fieldname="enabled"/>
            </column>
            <column name="from-date" numcolumns="3" order="110">
                <widget type="date" fieldname="fromdate"/>
            </column>
            <column name="max-emails-per-run" display="right" numcolumns="2" order="120">
                <widget type="number" fieldname="maxemails" min="1" max="500"/>
            </column>
            <column name="delay-minutes" display="right" numcolumns="2" order="125">
                <widget type="number" fieldname="delayminutes" min="0" max="1440"/>
            </column>
            <column name="include-rectified-invoices" display="left" numcolumns="2" order="130">
                <widget type="checkbox" fieldname="rectificativas"/>
            </column>
        </group>
        <group name="autoenviofacturas-email" title="autoenvio-email-text" icon="fa-solid fa-envelope-open-text"
               description="autoenvio-email-text-desc" numcolumns="12">
            <column name="bcc-email" numcolumns="4" order="140">
                <widget type="text" fieldname="cco"/>
            </column>
        </group>
    </columns>
</view>
