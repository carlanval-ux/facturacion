{% if errores is null %}
    <div class="alert alert-warning mb-0">{{ trans('instalacion-visor-sin-datos') }}</div>
{% else %}
    {% if errores is not empty %}
        <div class="text-end mb-3">
            <button type="button" class="btn btn-danger btn-sm" data-accion="error-delete-all"
                    data-confirm="{{ trans('instalacion-errores-eliminar-todos-confirm') }}">
                <i class="fa-solid fa-trash-can fa-fw" aria-hidden="true"></i> {{ trans('instalacion-errores-eliminar-todos') }}
            </button>
        </div>
    {% endif %}

    {% for error in errores %}
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <span class="fw-semibold text-break">{{ error.datos.message|slice(0, 150) }}</span>
                <div class="d-flex align-items-center gap-2 text-nowrap">
                    <small class="text-muted">{{ error.fecha }}</small>
                    <button type="button" class="btn btn-sm btn-outline-danger" title="{{ trans('instalacion-error-eliminar') }}"
                            data-accion="error-delete" data-hash="{{ error.hash }}"
                            data-confirm="{{ trans('instalacion-error-eliminar-confirm') }}">
                        <i class="fa-solid fa-trash-can fa-fw" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="card-body small">
                <pre class="bg-body-tertiary p-2 rounded text-break mb-3" style="white-space: pre-wrap;">{{ error.datos.message }}</pre>
                <div class="row g-2">
                    <div class="col-md-6"><strong>{{ trans('file') }}:</strong> {{ error.datos.file }}</div>
                    <div class="col-md-6"><strong>{{ trans('line') }}:</strong> {{ error.datos.line }}</div>
                    <div class="col-md-6 text-break"><strong>{{ trans('url') }}:</strong> {{ error.datos.url }}</div>
                    <div class="col-md-6"><strong>{{ trans('ip') }}:</strong> {{ error.datos.ip }}</div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-success mb-0">{{ trans('instalacion-errores-ninguno') }}</div>
    {% endfor %}
{% endif %}
