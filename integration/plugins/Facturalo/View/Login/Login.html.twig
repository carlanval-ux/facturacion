{% extends "Master/MicroTemplate.html.twig" %}

{% block fullBody %}
    <body class="fl-login">
    {% include 'Macro/Toasts.html.twig' %}
    {% from 'Macro/Utils.html.twig' import message as showMessage %}
    <main>
        <div class="w-100" style="max-width:26rem">
            <div role="status">
                {{ showMessage(log, ['error', 'critical'], 'danger') }}
                {{ showMessage(log, ['warning'], 'warning') }}
                {{ showMessage(log, ['notice'], 'success') }}
                {{ showMessage(log, ['info'], 'info') }}
            </div>
            <form action="{{ asset('login') }}" method="post" class="fl-card">
                {{ formToken() }}
                <input type="hidden" name="action" value="login">
                <a href="{{ asset('login') }}">{{ _self.loadLogo(settings('default','idloginimage', 0)) }}</a>
                <h1>Entra en tu facturación</h1>
                <p class="fl-sub">Facturas, clientes y cobros en un solo sitio.</p>
                <div class="mb-3">
                    <label for="fsNick" class="form-label">Usuario</label>
                    <input type="text" id="fsNick" name="fsNick" class="form-control form-control-lg" maxlength="50"
                           required autocomplete="username" autofocus/>
                </div>
                <div class="mb-2">
                    <label for="fsPassword" class="form-label">Contraseña</label>
                    <input type="password" id="fsPassword" name="fsPassword" class="form-control form-control-lg" maxlength="50"
                           required autocomplete="current-password"/>
                </div>
                <p class="mb-4">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#newPasswordModal">¿Has olvidado la contraseña?</a>
                </p>
                <button type="submit" class="btn btn-lg btn-primary w-100">Entrar</button>
            </form>
        </div>
    </main>
    <footer>Facturalo · RED TELECOM CONECTA, S.L.</footer>
    <form action="{{ asset('login') }}" method="post" class="form">
        {{ formToken() }}
        <input type="hidden" name="action" value="change-password">
        <div class="modal fade" id="newPasswordModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa-solid fa-user-lock me-2"></i> {{ trans('new-password') }}
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text">
                                        <i class="fa-solid fa-user fa-fw" aria-hidden="true"></i>
                                </span>
                                <input type="text" name="fsNewUserPasswd" class="form-control" maxlength="50"
                                       placeholder="{{ trans('user') }}" required autocomplete="off"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text">
                                        <i class="fa-solid fa-key fa-fw" aria-hidden="true"></i>
                                </span>
                                <input type="password" name="fsNewPasswd" class="form-control" maxlength="50"
                                       placeholder="{{ trans('new-password') }}" required autocomplete="off"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text">
                                        <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                                </span>
                                <input type="password" name="fsNewPasswd2" class="form-control" maxlength="50"
                                       placeholder="{{ trans('repeat-new-password') }}"
                                       required autocomplete="off"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <p class="small text-muted">Para cambiarla aquí necesitas la clave técnica de la instalación. Si no la tienes, pide a RED TELECOM que te restablezca el acceso.</p>
                            Clave técnica
                            <div class="input-group">
                                <span class="input-group-text">
                                        <i class="fa-solid fa-database fa-fw" aria-hidden="true"></i>
                                </span>
                                <input type="password" name="fsDbPasswd" class="form-control"
                                       placeholder="{{ trans('db-password') }}" autocomplete="off"/>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary w-100">{{ trans('save') }}</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    </body>
{% endblock %}




{% macro loadLogo(idfile) %}
    {% set url = 'Dinamic/Assets/Images/horizontal-logo.png' %}
    {% if idfile > 0 %}
        {% set attached = attachedFile(idfile) %}
        {% if attached.filename is not empty %}
            {% set url = attached.url('download-permanent') %}
        {% endif %}
    {% endif %}
    <img class="fl-logo" src="{{ asset(url) }}" alt="Facturalo"/>
{% endmacro loadLogo %}